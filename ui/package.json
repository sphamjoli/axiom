{
  "name": "axiom-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "wasm": "cargo build --manifest-path ../Cargo.toml -p axiom-wasm --release --locked --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir src/engine/wasm ../target/wasm32-unknown-unknown/release/axiom_wasm.wasm",
    "build": "bun run wasm && vite build",
    "typecheck": "bun run wasm && vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/tsconfig": "0.9.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
