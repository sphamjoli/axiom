    {
      "id": "mwcjki7orznzeszr2ss",
      "type": "text",
      "x": 40,
      "y": 575,
      "width": 922,
      "height": 120,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 3,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "aW",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "a = P(up -> down) = 1/10;  b = P(down -> up) = 3/10\nupdate: d' = 0.6 d + 0.1  (d = probability a link is down)\nsteady state d* = 1/4;  contraction factor lambda = 3/5\nwithin 1/1000 of d* for every t >= 13 (from d0 = 1)\nretries: x = 0.3 + 0.7 x gives x = 1;  expected attempts 10/3\nreject: steady state 0.3;  contraction claim for a = b = 1 (lambda = -1)",
      "roughness": 1,
      "roundness": null,
      "seed": 1718328344,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "a = P(up -> down) = 1/10;  b = P(down -> up) = 3/10\nupdate: d' = 0.6 d + 0.1  (d = probability a link is down)\nsteady state d* = 1/4;  contraction factor lambda = 3/5\nwithin 1/1000 of d* for every t >= 13 (from d0 = 1)\nretries: x = 0.3 + 0.7 x gives x = 1;  expected attempts 10/3\nreject: steady state 0.3;  contraction claim for a = b = 1 (lambda = -1)",
      "textAlign": "left",
      "updated": 1794427108440,
      "version": 1,
