import AxiomEngine.Generated.Funs
import AxiomCheck.Semantics
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Ring

/-!
# Correctness of the covered engine functions

Proof 3: the Lean translation of each engine function covered by
`proof3.toml`, generated by Aeneas from the Rust in `axiom_core::kernel`,
returns `ok` on every input and computes what `AxiomCheck.Semantics` says.
Returning `ok` means the Rust function does not panic. The rational interface
is modelled as `Rat` in `AxiomEngine.Generated.FunsExternal`, which is the
trusted part of this proof.

This file is not a `module`: it imports the checker's `AxiomCheck.Semantics`,
which is built from `../lean` and must also build on Lean v4.19, where the
module system is unavailable, and a `module` cannot import a non-`module`.
Lake therefore warns that it imports mathlib from outside the module system.
-/

namespace AxiomEngine.Correctness

open Aeneas Aeneas.Std Result
open AxiomCheck.Semantics

/-- The translated complement returns `ok (1 - p)` for every `p`. -/
theorem complement_ok (p : Rat) : kernel.complement p = ok (1 - p) := by
  simp [kernel.complement, exact_rational.ExactRational.one,
    exact_rational.ExactRational.sub]

/-- The translated contraction factor returns `ok` with the factor `λ` of the
semantics, `1 - a - b`, for every `a` and `b`. -/
theorem contraction_factor_ok (a b : Rat) :
    kernel.contraction_factor a b = ok (TwoState.lam ⟨a, b⟩) := by
  simp [kernel.contraction_factor, complement_ok,
    exact_rational.ExactRational.sub, TwoState.lam]

/-- The translated affine update returns `ok (factor * value + offset)` for
every input. -/
theorem affine_apply_ok (factor offset value : Rat) :
    kernel.affine_apply factor offset value = ok (factor * value + offset) := by
  simp [kernel.affine_apply, exact_rational.ExactRational.mul,
    exact_rational.ExactRational.add]

/-- With the factor and offset a two-state chain builds, the translated affine
update is the semantics' update `TwoState.update`. -/
theorem affine_apply_two_state (a b value : Rat) :
    kernel.affine_apply (TwoState.lam ⟨a, b⟩) a value =
      ok (TwoState.update ⟨a, b⟩ value) := by
  simp [affine_apply_ok, TwoState.update, TwoState.offset]

/-- When `a + b ≠ 0`, the translated steady state returns `ok` with the
semantics' fixed point `a / (a + b)`. -/
theorem steady_state_ok (a b : Rat) (h : a + b ≠ 0) :
    kernel.steady_state a b = ok (core.result.Result.Ok (TwoState.fixedPoint ⟨a, b⟩)) := by
  simp [kernel.steady_state, exact_rational.ExactRational.add,
    exact_rational.ExactRational.is_zero, exact_rational.ExactRational.div, h,
    TwoState.fixedPoint]

/-- When `a + b = 0`, the translated steady state returns `ok` with the error
`NoUniqueFixedPoint`, so it does not panic either. -/
theorem steady_state_no_unique (a b : Rat) (h : a + b = 0) :
    kernel.steady_state a b =
      ok (core.result.Result.Err two_state_chain.TwoStateChainError.NoUniqueFixedPoint) := by
  simp [kernel.steady_state, exact_rational.ExactRational.add,
    exact_rational.ExactRational.is_zero, h]

/-- When `a + b ≠ 0`, the value `d*` the translated steady state returns is a
fixed point of the translated affine update with the translated contraction
factor `λ` and offset `c = a`: `d* = λ d* + c`. -/
theorem steady_state_is_fixed_point (a b : Rat) (h : a + b ≠ 0) :
    ∃ d lam, kernel.steady_state a b = ok (core.result.Result.Ok d) ∧
      kernel.contraction_factor a b = ok lam ∧
      kernel.affine_apply lam a d = ok d ∧ FixedPointHolds ⟨a, b⟩ d := by
  refine ⟨TwoState.fixedPoint ⟨a, b⟩, TwoState.lam ⟨a, b⟩, steady_state_ok a b h,
    contraction_factor_ok a b, ?_, ?_⟩ <;>
  · simp only [affine_apply_ok, FixedPointHolds, TwoState.update, TwoState.lam,
      TwoState.offset, TwoState.fixedPoint, ok.injEq]
    field_simp
    ring

end AxiomEngine.Correctness
