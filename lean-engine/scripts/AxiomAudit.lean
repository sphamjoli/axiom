import AxiomEngine
import Lean

/-!
# Axiom audit for proof 3

Kernel-level audit run by `scripts/checkEngine.sh`. Every constant declared in
a module of the `AxiomEngine` library, the generated translation, the models
of the rational interface and the correctness theorems alike, must depend only
on `propext`, `Classical.choice` and `Quot.sound`. The rational interface is
modelled by definitions, not axioms, so it adds none. The audit also fails if
no `AxiomEngine` module is imported or no correctness theorem is found, so it
cannot silently become a no-op.

Declarations generated by the compiler (name components `_cstage1`,
`_cstage2`, `_at` and `_spec_<n>`) are skipped: the compiler stores them as
axioms holding executable code, and no kernel proof refers to them.
-/

open Lean Elab Command

/-- The axioms an engine declaration may depend on. -/
def allowedAxioms : List Name := [``propext, ``Classical.choice, ``Quot.sound]

/-- Whether `decl` was generated by the compiler rather than written or
translated. -/
def isCompilerGenerated (decl : Name) : Bool :=
  decl.components.any fun component =>
    match component with
    | .str _ s => s == "_cstage1" || s == "_cstage2" || s == "_at" || s.startsWith "_spec_"
    | _ => false

/-- Reports every `AxiomEngine` declaration that depends on a disallowed
axiom. -/
elab "#audit_engine_axioms" : command => do
  let env ← getEnv
  unless env.header.moduleNames.any (·.getRoot == `AxiomEngine) do
    logError "no AxiomEngine module is imported, so nothing would be audited"
  unless env.contains `AxiomEngine.Correctness.steady_state_ok do
    logError "the correctness theorems are missing, so nothing would be audited"
  let mut audited : Nat := 0
  for (decl, _) in env.constants.map₁.toList do
    let some moduleIdx := env.getModuleIdxFor? decl | continue
    let some moduleName := env.header.moduleNames[moduleIdx.toNat]? | continue
    unless moduleName.getRoot == `AxiomEngine do continue
    if isCompilerGenerated decl then continue
    audited := audited + 1
    let disallowed := (← collectAxioms decl).filter (· ∉ allowedAxioms)
    unless disallowed.isEmpty do
      logError m!"{decl} depends on disallowed axioms: {disallowed.toList}"
  logInfo m!"Audited {audited} AxiomEngine declarations."

#audit_engine_axioms
